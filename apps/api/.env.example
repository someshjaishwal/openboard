# Copy to apps/api/.env (do not put comments on the same shell line as `cp`).
# Local Docker: keep the URL below and run `pnpm db:up`.
# Neon: replace with the pooled URI (host contains -pooler).

DATABASE_URL=postgresql://openboard:openboard@localhost:55432/openboard
JWT_SECRET=change-me-to-a-long-random-string
PORT=3100

# Comma-separated browser origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Local: lax + insecure cookies work across localhost ports.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Phase 2 (shared parent domain): COOKIE_DOMAIN=.example.com
COOKIE_DOMAIN=

# Local admin without Cloudflare Access.
ADMIN_DEV_BYPASS=true

# Phase 2 — https://<team>.cloudflareaccess.com and the Access application's AUD tag.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
